# Copiar a .env (en la raíz) para usar con `docker compose`.
# Nunca commitear el .env real. Ejemplo de valores, no credenciales reales.

# --- PostgreSQL (contenedor) ---
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=realtime_chat_docker
POSTGRES_PORT=55432

# --- apps/api ---
API_PORT=3000
DATABASE_URL=postgresql://chatapp:changeme_local_only@postgres:5432/realtime_chat_docker
SOCKET_CORS_ORIGIN=http://localhost:8080
MESSAGE_HISTORY_DEFAULT_LIMIT=50
MESSAGE_HISTORY_MAX_LIMIT=100

# --- apps/web ---
WEB_PORT=8080
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
