# Copy to .env and fill in real values locally. Never commit .env.

# --- General ---
NODE_ENV=development

# --- apps/api ---
API_PORT=3000
SOCKET_CORS_ORIGIN=http://localhost:5173

# --- apps/web ---
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# --- Database (Phase 3: PostgreSQL + Prisma) ---
# Example only - never commit a real DATABASE_URL with credentials.
DATABASE_URL=
DATABASE_URL_TEST=

# --- Message history pagination ---
MESSAGE_HISTORY_DEFAULT_LIMIT=50
MESSAGE_HISTORY_MAX_LIMIT=100
