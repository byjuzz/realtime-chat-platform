{
  "name": "realtime-chat-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Realtime chat platform monorepo - React/Vite frontend, Node.js/Express/Socket.IO API, Kubernetes (RKE2) multi-environment deployment.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "prebuild": "npm run build:shared",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
